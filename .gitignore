# Env
.env
infra/.env
# `.env` above matches only a file named exactly `.env`, not `.env.local`.
.env*.local

# Node / Next.js (frontend/, ADR-0031) — added in the commit before frontend/ was
# created, so its first `git add` could not stage either.
node_modules/
.next/
# Regenerated by every `next dev` and `next build`, with different imports from each
# (.next/dev/types vs .next/types), so a tracked copy would flip with whichever ran last.
next-env.d.ts

