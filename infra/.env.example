# Local dev defaults for infra/docker-compose.yml and the app itself.
# Copy to infra/.env and adjust if needed.
POSTGRES_USER=verion
POSTGRES_PASSWORD=verion
POSTGRES_DB=verion
POSTGRES_PORT=5432

REDIS_PORT=6379

APP_NAME=verion
APP_ENV=local
DEBUG=true
LOG_LEVEL=info

DATABASE_URL=postgresql+asyncpg://verion:verion@localhost:5432/verion
REDIS_URL=redis://localhost:6379/0

# Dev-only default — override in any real deployment.
JWT_SECRET_KEY=dev-secret-change-in-production-32b
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30

# GitHub OAuth App credentials — register one at https://github.com/settings/developers
# for local dev. GITHUB_CLIENT_SECRET is dev-only default — override in any real deployment.
GITHUB_CLIENT_ID=dev-github-client-id
GITHUB_CLIENT_SECRET=dev-github-client-secret-placeholder
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Where the browser lands after OAuth completes — no real frontend yet, placeholder.
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/dashboard
