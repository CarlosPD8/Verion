# Local dev defaults for infra/docker-compose.yml and the app itself.
# Copy to infra/.env and adjust if needed.
POSTGRES_USER=verion
POSTGRES_PASSWORD=verion
POSTGRES_DB=verion
POSTGRES_PORT=5432

REDIS_PORT=6379

APP_NAME=verion
APP_ENV=local
DEBUG=true
LOG_LEVEL=info

DATABASE_URL=postgresql+asyncpg://verion:verion@localhost:5432/verion

# Dev-only default — override in any real deployment.
JWT_SECRET_KEY=dev-secret-change-in-production-32b
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30
